{
  "name": "villa-aesthetic",
  "version": "1.0.0",
  "private": true,
  "description": "Public website for Villa Aesthetic: villa holiday rentals on the Greek islands (static HTML/CSS/vanilla JS + Firebase Firestore).",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve . -l 3000",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "build": "node scripts/build-config.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.922.0",
    "@aws-sdk/s3-request-presigner": "3.922.0",
    "firebase-admin": "13.10.0"
  }
}
